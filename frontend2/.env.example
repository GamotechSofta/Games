# Frontend (user site) – Vite (npm run dev)
# Backend API (required)
VITE_API_BASE_URL=http://localhost:3010/api/v1

# Optional: use production API via Vite proxy (avoids CORS in dev)
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_PROXY_TARGET=https://api.singlepana.in
# VITE_BACKEND_BASE_URL=https://api.singlepana.in

# Socket.IO origin (optional; defaults from API / proxy)
# VITE_SOCKET_URL=http://localhost:3010

# Static assets (optional)
# VITE_ANDROID_APK_URL=
# VITE_FRONTEND_URL=http://localhost:5173
