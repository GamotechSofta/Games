# Copy to .env and fill in values

PORT=3010
MONGODB_URI=mongodb://127.0.0.1:27017/Games

# Player app (production URL without trailing slash)
FRONTEND_BASE_URL=http://localhost:5173

# Optional panel URLs — merged into CORS allowed origins
ADMIN_BASE_URL=http://localhost:5173
BOOKIE_BASE_URL=http://localhost:5174
TELECALLER_BASE_URL=http://localhost:5177

# Comma-separated browser origins (no trailing slash)
# Include telecaller dev: http://localhost:5177,http://127.0.0.1:5177
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5177,http://127.0.0.1:5177

# In production, set CORS_INCLUDE_LOCAL_DEV=false (default: local ports added only when NODE_ENV is not production)
# CORS_INCLUDE_LOCAL_DEV=false

ENCRYPTION_KEY=your-32-char-or-longer-secret

# --- JWT (player OTP / password login) ---
JWT_SECRET=your-long-random-secret
USER_TOKEN_EXPIRY=7d

# --- MSG91 OTP (https://docs.msg91.com/otp) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
# Dev fallback when MSG91_AUTH_KEY is unset or placeholder (logs OTP to server console)
OTP_DEV_MODE=false
OTP_DEV_CODE=123456

# --- WebRTC: YOUR OWN TURN (required for different internet) ---
# Run coturn on a VPS — see backend/turn-server/README.md
# Generate password: npm run generate-turn-secret
# Verify: npm run check-turn
#
# TURN_URL=turn:YOUR_VPS_PUBLIC_IP:3478
# TURN_USERNAME=games
# TURN_PASSWORD=your_long_secret
# STUN_URLS=stun:YOUR_VPS_PUBLIC_IP:3478
#
# Optional: full iceServers JSON you control
# ICE_SERVERS_JSON=[{"urls":"stun:YOUR_IP:3478"},{"urls":"turn:YOUR_IP:3478","username":"games","credential":"secret"}]
#
# Optional third-party (not needed if you self-host):
# METERED_TURN_API_KEY=

# --- Web Push: "Aakda.in is calling" when user left site / phone locked (no Firebase) ---
# Run: npm run generate-vapid
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@aakda.in

# --- Admin security (Week 5+) ---
# ALLOW_BOOTSTRAP_ADMIN=true   # only enable briefly for first super-admin HTTP create
# ADMIN_LOGIN_RATE_LIMIT=10
# JWT_SECRET=generate-a-long-random-secret-for-production
# DEV_TOOLS_SECRET=local-only-secret-for-test-ip-and-test-reset
# GAP_LOOKUP_SECRET=dev-only-x-gap-secret-bypass (disabled in production NODE_ENV)

# --- Admin performance cache (Week 4) ---
# Optional Redis — shares dashboard & bookie-user-map cache across Node processes.
# Leave unset for local dev unless Redis is running (otherwise in-memory cache is used).
# REDIS_URL=redis://127.0.0.1:6379
# DASHBOARD_CACHE_TTL_MS=30000
# BOOKIE_USER_MAP_CACHE_TTL_MS=300000

# --- High traffic / production (10k+ users/day) ---
# NODE_ENV=production
# MONGO_MAX_POOL_SIZE=100
# MONGO_MIN_POOL_SIZE=5
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
# API_MAX_IN_FLIGHT=70
# API_MAX_QUEUE=120
# API_REQUEST_TIMEOUT_MS=28000
# HEARTBEAT_WRITE_INTERVAL_MS=120000
# WALLET_SOCKET_ENABLED=false
# CALL_SOCKET_ENABLED=true
