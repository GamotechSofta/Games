PORT=3010
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/Games

BACKEND_BASE_URL=http://localhost:3010
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated browser origins (no trailing slash). Also accepts CORS_ORIGIN (singular).
# FRONTEND_BASE_URL is merged automatically if not listed here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Cloudinary, PayU, GAP — add your own values
# CLOUDINARY_CLOUD_NAME=
# PAYU_KEY=
# GAP_BASE_URL=
# OPERATOR_ID=
