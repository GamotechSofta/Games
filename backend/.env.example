PORT=3010
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Runtime
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:3010

# Auth
JWT_SECRET=change-me-in-production
ADMIN_TOKEN_EXPIRY=24h
BOOKIE_TOKEN_EXPIRY=24h
ENCRYPTION_KEY=

# Wallet limits (optional)
MIN_DEPOSIT=100
MAX_DEPOSIT=50000
MIN_WITHDRAWAL=500
MAX_WITHDRAWAL=25000

# Cloudinary (optional – uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GAP Integration
GAP_BASE_URL=https://provider.example.com
OPERATOR_ID=YOUR_OPERATOR_ID
GAP_SIGNATURE_ENABLED=false
GAP_PUBLIC_KEY=
GAP_PUBLIC_KEY_PATH=./keys/public.pem
GAP_PRIVATE_KEY_PATH=./keys/private.pem
GAP_LOOKUP_SECRET=
GAP_WALLET_RATE_LIMIT_MAX=120

# PayU (optional if payment gateway is enabled)
PAYU_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_MERCHANT_ID=
PAYU_MODE=TEST